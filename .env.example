# ---------------------------------------------------------------------------
# Understory — environment configuration
#
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored and must NEVER be committed.
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------

# --- CognoDB Cloud (production) --------------------------------------------
#
# From https://console.cognodb.com after creating a free (c0) instance.
# The password is displayed exactly once at creation time — copy it immediately.
#
#   NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.com
#   NEO4J_USERNAME=cognodb
#   NEO4J_PASSWORD=<the generated password>
#
# ⚠ Never put a real password in THIS file. `.env.example` is committed to git —
#   it is the public template. Real values belong in `.env.local`, which is
#   gitignored.
#
# --- Local development (Docker) --------------------------------------------
#
# `docker compose up -d` starts a Bolt-compatible database on localhost:7687
# with the credentials below. Use these while developing, then switch the three
# variables above for deployment.

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=understory-dev

# Database name. CognoDB and Neo4j both default to `neo4j`; leave as-is unless
# your instance says otherwise.
NEO4J_DATABASE=neo4j

# Bolt connection pool size. Kept deliberately small: the CognoDB free (c0) tier
# is a 0.5 vCPU / 256 MB instance, and serverless deploys create one pool per
# warm function instance. Raise only if you move to a larger tier.
NEO4J_MAX_POOL_SIZE=16

# ---------------------------------------------------------------------------
# Seed pipeline tuning (only read by `npm run db:seed`)
# ---------------------------------------------------------------------------

# How deep to crawl the transitive dependency tree from each root package.
SEED_MAX_DEPTH=5

# Hard ceiling on distinct packages fetched, to stay inside the free tier's
# 1 GB disk budget.
SEED_MAX_PACKAGES=900

# Concurrent outbound requests to the npm registry. Be polite.
SEED_CONCURRENCY=8
